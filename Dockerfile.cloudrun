FROM python:3.11-slim

WORKDIR /app

COPY apps/api/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir --upgrade pip && pip install --no-cache-dir -r /app/requirements.txt

COPY apps/api /app/apps/api
COPY shared/frames /app/shared/frames
COPY apps/web/src /app/apps/web/src

# Cloud Run sets PORT env var (default 8080); local Docker overrides via docker-compose.yml CMD.
ENV PORT=8080
ENV WEB_DIR=/app/apps/web/src
CMD exec uvicorn apps.api.app.main:app --host 0.0.0.0 --port $PORT

